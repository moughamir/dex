diff --git a/src-tauri/Cargo.toml b/src-tauri/Cargo.toml
new file mode 100644
index 0000000000000000000000000000000000000000..6d277c815323f656f6cc3cc535a1e7d381aed9e1
--- /dev/null
+++ b/src-tauri/Cargo.toml
@@ -0,0 +1,35 @@
+[package]
+name = "omnizya-dex"
+version = "0.1.0"
+description = "OmniZya DEX: A Desktop experience"
+authors = ["Mohamed Moughamir"]
+edition = "2021"
+
+# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html
+
+[lib]
+# The `_lib` suffix may seem redundant but it is necessary
+# to make the lib name unique and wouldn't conflict with the bin name.
+# This seems to be only an issue on Windows, see https://github.com/rust-lang/cargo/issues/8519
+name = "omnizya_dex_lib"
+crate-type = ["staticlib", "cdylib", "rlib"]
+
+[build-dependencies]
+tauri-build = { version = "2.6.3", features = [] }
+
+[dependencies]
+tauri = { version = "2.11.5", features = ["tray-icon"] }
+tauri-plugin-opener = "2.5.4"
+tauri-plugin-log = "2"
+serde = { version = "1.0.229", features = ["derive"] }
+serde_json = "1.0.151"
+tokio = { version = "1.53.1", features = ["full"] }
+rusqlite = { version = "0.40.1", features = ["bundled"] }
+anyhow = "1.0.104"
+thiserror = "2.0.19"
+trace = "0.1.7"
+tracing-subscriber = "0.3.23"
+uuid = { version = "1.24.0", features = ["v4"] }
+chrono = { version = "0.4.45", features = ["serde"] }
+zbus = { version = "5.18.0", features = ["tokio"] }
+zvariant = "5.13.1"
