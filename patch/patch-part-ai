+    }
+
+    #[must_use]
+    pub fn is_zombie(&self) -> bool {
+        self.state == ProcessState::Zombie
+    }
+
+    #[must_use]
+    pub fn command_line(&self) -> String {
+        self.command.join(" ")
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum ProcessState {
+    Unknown,
+    Running,
+    Sleeping,
+    Waiting,
+    Stopped,
+    Zombie,
+    Dead,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize,Deserialize)]
