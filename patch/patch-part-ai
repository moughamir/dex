+impl NetworkStatistics {
+    #[must_use]
+    pub fn total_bytes(&self) -> u64 {
+        self.rx_bytes + self.tx_bytes
+    }
+
+    #[must_use]
+    pub fn total_packets(&self) -> u64 {
+        self.rx_packets + self.tx_packets
+    }
+
