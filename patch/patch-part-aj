+        position: relative;
+
+        overflow: hidden;
+
+        border: 1px solid rgb(255 255 255 / 0.12);
+        background: linear-gradient(
+            180deg,
+            rgb(28 30 38 / 0.42),
+            rgb(18 20 28 / 0.3)
