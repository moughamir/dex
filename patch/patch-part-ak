+/* ==========================================================================
+   DEX Utilities
+   ========================================================================== */
+
+/* -------------------------------------------------------------------------- */
+/* Radius */
+/* -------------------------------------------------------------------------- */
+
+.dex-radius-sm {
+    border-radius: var(--radius-sm);
+}
+
+.dex-radius-md {
+    border-radius: var(--radius-md);
+}
+
+.dex-radius-lg {
+    border-radius: var(--radius-lg);
+}
+
+.dex-radius-xl {
+    border-radius: var(--radius-xl);
+}
+
+.dex-radius-full {
+    border-radius: var(--radius-full);
+}
+
+/* -------------------------------------------------------------------------- */
+/* Blur */
+/* -------------------------------------------------------------------------- */
+
+.dex-blur-none {
+    backdrop-filter: none;
+    -webkit-backdrop-filter: none;
+}
+
+.dex-blur-sm {
+    backdrop-filter: blur(var(--blur-sm));
+    -webkit-backdrop-filter: blur(var(--blur-sm));
+}
+
+.dex-blur-md {
+    backdrop-filter: blur(var(--blur-md));
+    -webkit-backdrop-filter: blur(var(--blur-md));
+}
+
+.dex-blur-lg {
+    backdrop-filter: blur(var(--blur-lg));
+    -webkit-backdrop-filter: blur(var(--blur-lg));
+}
+
+.dex-blur-xl {
+    backdrop-filter: blur(var(--blur-xl));
+    -webkit-backdrop-filter: blur(var(--blur-xl));
+}
+
+/* -------------------------------------------------------------------------- */
+/* Borders */
+/* -------------------------------------------------------------------------- */
+
+.dex-border {
+    border: 1px solid var(--border-default);
+}
+
+.dex-border-subtle {
+    border: 1px solid var(--border-subtle);
+}
+
+.dex-border-strong {
+    border: 1px solid var(--border-strong);
+}
+
+/* -------------------------------------------------------------------------- */
+/* Shadows */
+/* -------------------------------------------------------------------------- */
+
+.dex-shadow-sm {
+    box-shadow: var(--shadow-sm);
+}
+
+.dex-shadow-md {
+    box-shadow: var(--shadow-md);
+}
+
+.dex-shadow-lg {
+    box-shadow: var(--shadow-lg);
+}
+
+.dex-shadow-glow {
+    box-shadow:
+        var(--shadow-md),
+        var(--shadow-glow);
+}
+
+/* -------------------------------------------------------------------------- */
+/* Glow */
+/* -------------------------------------------------------------------------- */
+
+.dex-glow {
+    box-shadow:
+        var(--shadow-md),
+        var(--shadow-glow);
+}
+
+/* -------------------------------------------------------------------------- */
+/* Glass */
+/* -------------------------------------------------------------------------- */
+
+.dex-glass {
+    position: relative;
+
+    overflow: hidden;
+
+    isolation: isolate;
+
+    background: var(--surface-1);
+
+    border: 1px solid var(--glass-border);
+
+    backdrop-filter: blur(var(--blur-lg));
+
+    -webkit-backdrop-filter: blur(var(--blur-lg));
+
+    transition:
+        background-color var(--duration-fast) var(--ease-standard),
+        border-color var(--duration-fast) var(--ease-standard),
+        transform var(--duration-fast) var(--ease-standard),
+        box-shadow var(--duration-fast) var(--ease-standard);
+}
+
+.dex-glass::before {
+    content: "";
+
+    position: absolute;
+    inset: 0;
+
+    pointer-events: none;
+
+    background:
+        linear-gradient(
+            180deg,
+            rgb(255 255 255 / 0.12),
+            transparent 45%
+        );
+
+    opacity: .7;
+}
+
+.dex-glass-panel {
+    background: rgb(18 22 30 / .6);
+}
+
+.dex-glass-elevated {
+    background: var(--surface-2);
+
+    border-color: var(--glass-border-strong);
+}
+
+.dex-glass-raised {
+    background: var(--surface-3);
+
+    border-color: var(--glass-border-strong);
+}
+
+.dex-glass-hud {
+    background: var(--hud-bg);
+
+    border-color: var(--hud-border);
+}
+
+.dex-glass-sidebar {
+    background: var(--sidebar-bg);
+}
+
+.dex-glass-dock {
+    background: var(--dock-bg);
+
+    border-color: var(--dock-border);
+}
+
+/* -------------------------------------------------------------------------- */
+/* Interactive */
+/* -------------------------------------------------------------------------- */
+
+.dex-interactive {
+    cursor: pointer;
+
+    transition:
+        transform var(--duration-fast) var(--ease-standard),
+        box-shadow var(--duration-fast) var(--ease-standard),
+        border-color var(--duration-fast) var(--ease-standard),
+        background-color var(--duration-fast) var(--ease-standard);
+}
+
+.dex-interactive:hover {
+    transform: translateY(-2px);
+
+    border-color: var(--glass-border-strong);
+
+    box-shadow:
+        var(--shadow-lg),
+        var(--shadow-glow);
+}
+
+.dex-interactive:active {
+    transform: scale(.985);
+}
+
+.dex-interactive:focus-visible {
+    outline: none;
+
+    box-shadow: var(--focus-ring);
+}
+/* ========================================================================== */
+/* Background */
+/* ========================================================================== */
+
+.dex-aurora {
+	position: absolute;
+	inset: -25%;
+
+	background:
+		radial-gradient(circle at 20% 20%, var(--aurora-blue), transparent 35%),
+		radial-gradient(circle at 80% 10%, var(--aurora-purple), transparent 30%),
+		radial-gradient(circle at 50% 100%, var(--aurora-cyan), transparent 35%);
+
+	filter: blur(120px);
+
+	animation: dexAurora 24s linear infinite alternate;
+}
+
+.dex-grid {
+	position: absolute;
+	inset: 0;
+
+	background-image:
+		linear-gradient(var(--border-subtle) 1px, transparent 1px),
+		linear-gradient(90deg, var(--border-subtle) 1px, transparent 1px);
+
+	background-size: 48px 48px;
+
+	mask-image: radial-gradient(circle, black, transparent 90%);
+
+	opacity: .35;
+}
+
+@keyframes dexAurora {
+
+	from {
+		transform:
+			translate3d(0,0,0)
+			scale(1);
+	}
+
+	to {
+		transform:
+			translate3d(4%,2%,0)
+			scale(1.08);
+	}
+
+}
