{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omnizya-dex",
  "version": "0.1.0",
  "identifier": "io.github.moughamir.dex",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "omnizya-dex",
        "width": 800,
        "height": 600,
        "shadow": false,
        "fullscreen": true,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
